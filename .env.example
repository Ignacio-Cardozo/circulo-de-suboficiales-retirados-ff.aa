# En Neon: Dashboard → Connect → "Connection string" → copiar completa
# Debe empezar con postgresql:// (no es la URL del panel ni una API key)
DATABASE_URL=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth: Dashboard → Auth → Configuration → Auth Base URL
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# Respaldos (Configuración → Respaldos). Ver docs/BACKUPS.md
# Token fine-grained de GitHub con permiso "Actions: Read and write" sobre el repo
BACKUP_GITHUB_TOKEN=
# Misma clave que el secret BACKUP_PASSPHRASE de GitHub Actions (mín. 16 caracteres)
BACKUP_PASSPHRASE=
# owner/repositorio (opcional en Vercel si se exponen las variables VERCEL_GIT_*)
BACKUP_GITHUB_REPO=Ignacio-Cardozo/circulo-de-suboficiales-retirados-ff.aa
# Ambiente de respaldos: "prueba" (local, por defecto) o "produccion" (deploy de producción en Vercel).
# BACKUP_AMBIENTE=prueba
